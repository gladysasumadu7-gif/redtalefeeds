# --- App-side (safe to expose, bundled into the client) ---------------------
EXPO_PUBLIC_API_BASE_URL=https://api.redtail.app
EXPO_PUBLIC_USE_MOCKS=false
# Set to "false" to use the real Google sign-in flow instead of the mock.
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Backend-side only (NEVER add these with an EXPO_PUBLIC_ prefix, and
#     never ship them in the app bundle) -------------------------------------
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# These are used by the backend's /auth/google/start endpoint to run the
# OAuth code exchange with Google server-side. See src/services/authService.ts
# for the exact flow the app expects from that endpoint.
